# Copy this file to .env and fill in your values
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Linux/macOS: $HOME/.gcp/nfip-pipeline.json
# Windows (Git Bash): C:/Users/you/.gcp/nfip-pipeline.json
GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/nfip-pipeline.json

# Terraform reads TF_VAR_* variables automatically
TF_VAR_project_id=${PROJECT_ID}
TF_VAR_location=${REGION}
TF_VAR_bucket_name=${PROJECT_ID}-data-lake

# Public HTTPS URL of this repository (Kestra clones it to run dbt). Use your fork's URL.
GIT_REPO_URL=https://github.com/vinithedev/nfip-flood-claims-pipeline.git

# Service account key as base64, exposed to Kestra as the secret GCP_SERVICE_ACCOUNT (used by dbt).
# Generate it with: echo "GCP_SERVICE_ACCOUNT_B64=$(base64 < "$GOOGLE_APPLICATION_CREDENTIALS" | tr -d '\n')" >> .env
GCP_SERVICE_ACCOUNT_B64=
